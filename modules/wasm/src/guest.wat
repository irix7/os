(module
  (import "i7host" "host_version" (func $version (result i32)))
  (import "i7host" "host_now" (func $now (result i64)))
  (import "i7host" "host_submit" (func $submit (param i32 i64 i64 i64 i64) (result i64)))
  (import "i7host" "host_poll" (func $poll (param i32 i32) (result i32)))
  (import "i7host" "host_cancel" (func $cancel (param i64) (result i32)))
  (import "i7host" "host_cap_check" (func $cap (param i64 i32 i32) (result i32)))
  (import "i7host" "host_console_write" (func $write (param i32 i32)))
  (import "i7host" "host_yield" (func $yield))
  (memory (export "memory") 1)
  (data (i32.const 0) "wasm: host=1\n")
  (func (export "run") (result i32)
    (local $token i64)
    (local $polled i32)
    (drop (call $version))
    (drop (call $now))
    (local.set $token
      (call $submit (i32.const 1) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0)))
    (if (i64.ne (local.get $token) (i64.const 1))
      (then (return (i32.const 1))))
    (local.set $polled (call $poll (i32.const 64) (i32.const 1)))
    (if (i32.ne (local.get $polled) (i32.const 1))
      (then (return (i32.const 2))))
    (drop (call $cancel (i64.const 1)))
    (drop (call $cap (i64.const 1) (i32.const 1) (i32.const 0)))
    (call $write (i32.const 0) (i32.const 13))
    (call $yield)
    (i32.const 42)))
