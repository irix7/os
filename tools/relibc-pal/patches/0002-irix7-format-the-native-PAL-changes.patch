From d484536c49fed26a5377d2c511962b891e1c8dfb Mon Sep 17 00:00:00 2001
From: Jupiter Belic <belikh@users.noreply.github.com>
Date: Mon, 2 Nov 2026 15:32:25 +1000
Subject: [PATCH 2/2] irix7: format the native PAL changes

Run rustfmt over the files touched by the PAL bring-up.  No functional
change.

Signed-off-by: Jupiter Belic <belikh@users.noreply.github.com>
---
 src/header/netdb/mod.rs   |  6 ++++-
 src/header/pthread/mod.rs |  6 ++---
 src/platform/irix7/mod.rs | 49 +++++++++++----------------------------
 3 files changed, 21 insertions(+), 40 deletions(-)

diff --git a/src/header/netdb/mod.rs b/src/header/netdb/mod.rs
index a3a806cc..cb0c2f67 100644
--- a/src/header/netdb/mod.rs
+++ b/src/header/netdb/mod.rs
@@ -334,7 +334,11 @@ pub unsafe extern "C" fn gethostbyaddr(
             unsafe { (*cp).copy_to(cp_slice.as_mut_ptr(), 4) };
             #[cfg(any(target_arch = "x86_64", target_arch = "x86"))]
             let cp_s_addr = unsafe { mem::transmute::<[c_char; 4], u32>(cp_slice) };
-            #[cfg(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "mips64"))]
+            #[cfg(any(
+                target_arch = "riscv64",
+                target_arch = "aarch64",
+                target_arch = "mips64"
+            ))]
             let cp_s_addr = u32::from_ne_bytes(cp_slice.map(|c| c as u8));
             if cp_s_addr == addr.s_addr {
                 unsafe { sethostent(HOST_STAYOPEN) };
diff --git a/src/header/pthread/mod.rs b/src/header/pthread/mod.rs
index 1f34ed00..f64003fa 100644
--- a/src/header/pthread/mod.rs
+++ b/src/header/pthread/mod.rs
@@ -330,9 +330,9 @@ pub(crate) struct CleanupLinkedListEntry {
 pub(crate) static CLEANUP_LL_HEAD: Cell<*const CleanupLinkedListEntry> =
     Cell::new(core::ptr::null());
 #[cfg(target_os = "irix7")]
-pub(crate) static CLEANUP_LL_HEAD:
-    crate::platform::SingleThread<Cell<*const CleanupLinkedListEntry>> =
-    crate::platform::SingleThread(Cell::new(core::ptr::null()));
+pub(crate) static CLEANUP_LL_HEAD: crate::platform::SingleThread<
+    Cell<*const CleanupLinkedListEntry>,
+> = crate::platform::SingleThread(Cell::new(core::ptr::null()));
 
 // TODO: unwind? setjmp/longjmp?
 
diff --git a/src/platform/irix7/mod.rs b/src/platform/irix7/mod.rs
index 727d4cfe..5c897451 100644
--- a/src/platform/irix7/mod.rs
+++ b/src/platform/irix7/mod.rs
@@ -21,12 +21,7 @@
 //! * There is no process, thread, signal or socket support, hence the ENOSYS
 //!   stubs in [`PalSignal`], [`PalSocket`], [`PalEpoll`] and [`PalPtrace`].
 
-use core::{
-    arch::asm,
-    mem::size_of,
-    num::NonZeroU64,
-    ptr,
-};
+use core::{arch::asm, mem::size_of, num::NonZeroU64, ptr};
 
 use super::{Pal, PalEpoll, PalPtrace, PalSignal, PalSocket, types::*};
 use crate::{
@@ -308,16 +303,7 @@ impl Pal for Sys {
 
     fn fstat(fildes: c_int, mut buf: Out<stat>) -> Result<()> {
         // The kernel writes relibc's 136-byte n32 `struct stat` directly.
-        unsafe {
-            syscall(
-                SYS_FSTAT,
-                fildes as usize,
-                buf.as_mut_ptr() as usize,
-                0,
-                0,
-            )
-        }
-        .map(|_| ())
+        unsafe { syscall(SYS_FSTAT, fildes as usize, buf.as_mut_ptr() as usize, 0, 0) }.map(|_| ())
     }
 
     fn fstatat(fildes: c_int, path: Option<CStr>, mut buf: Out<stat>, _flags: c_int) -> Result<()> {
@@ -330,7 +316,13 @@ impl Pal for Sys {
                     return enosys();
                 }
                 unsafe {
-                    syscall(SYS_STAT, path.as_ptr() as usize, buf.as_mut_ptr() as usize, 0, 0)
+                    syscall(
+                        SYS_STAT,
+                        path.as_ptr() as usize,
+                        buf.as_mut_ptr() as usize,
+                        0,
+                        0,
+                    )
                 }?;
                 return Ok(());
             }
@@ -346,15 +338,7 @@ impl Pal for Sys {
         // The kernel treats fcntl as an unconditional success with no side
         // effects.  Passing it through keeps F_GETFD/F_SETFD working for stdio,
         // but no command is actually interpreted.
-        let value = unsafe {
-            syscall(
-                SYS_FCNTL,
-                fildes as usize,
-                cmd as usize,
-                arg as usize,
-                0,
-            )
-        }?;
+        let value = unsafe { syscall(SYS_FCNTL, fildes as usize, cmd as usize, arg as usize, 0) }?;
         Ok(value as c_int)
     }
 
@@ -643,15 +627,8 @@ impl Pal for Sys {
     ) -> Result<*mut c_void> {
         // Provisional mmap(addr, length, prot, flags): the kernel ignores the
         // address, protection and flags and bumps a fixed 1 MiB heap.
-        let address = unsafe {
-            syscall(
-                SYS_MMAP,
-                addr as usize,
-                len,
-                prot as usize,
-                flags as usize,
-            )
-        }?;
+        let address =
+            unsafe { syscall(SYS_MMAP, addr as usize, len, prot as usize, flags as usize) }?;
         Ok(address as *mut c_void)
     }
 
@@ -1142,8 +1119,8 @@ impl PalSocket for Sys {
 // conversion are pinned here so an ABI change fails the build rather than the
 // first stat() at runtime.
 const _: () = {
-    use core::mem::offset_of;
     use crate::header::{dirent::dirent, poll::pollfd, time::timespec};
+    use core::mem::offset_of;
 
     assert!(size_of::<stat>() == 136);
     assert!(offset_of!(stat, st_nlink) == 16);
-- 
2.55.0

