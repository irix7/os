From bf5fee5e29a7a5054fa3cf82f6c5916de4b45b19 Mon Sep 17 00:00:00 2001
From: Jupiter Belic <belikh@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:18:47 +1000
Subject: [PATCH 8/8] irix7: sleep on the native nanosleep gate and add
 clock_nanosleep

Map nanosleep to a real SYS_NANOSLEEP park: the kernel sleeps the calling
thread on a CP0 Count deadline and lets a cooperative peer run meanwhile.
One park is bounded to keep the deadline inside half the 32-bit Count range;
the PAL re-arms with the remainder for a longer interval and leaves rmtp
untouched because there are no signals.

Implement clock_nanosleep over the same primitive for CLOCK_REALTIME and
CLOCK_MONOTONIC, with TIMER_ABSTIME converted to a relative interval against
the same clock.  POSIX returns the error number directly, so thrd_sleep
adapts it to C11's 0/-1/other-negative contract.

Signed-off-by: Jupiter Belic <belikh@users.noreply.github.com>
---
 src/header/threads/mod.rs | 11 +++++----
 src/header/time/mod.rs    | 49 +++++++++++++++++++++++++++++++++++----
 src/platform/irix7/mod.rs | 45 ++++++++++++++++++++++++++++++++---
 3 files changed, 93 insertions(+), 12 deletions(-)

diff --git a/src/header/threads/mod.rs b/src/header/threads/mod.rs
index eb67ba55..2febc2f7 100644
--- a/src/header/threads/mod.rs
+++ b/src/header/threads/mod.rs
@@ -269,14 +269,15 @@ pub unsafe extern "C" fn thrd_join(thrd: thrd_t, retval: *mut c_int) -> c_int {
 }
 
 /// See <https://pubs.opengroup.org/onlinepubs/9799919799/functions/thrd_sleep.html>.
+///
+/// `clock_nanosleep` reports the error as its return value, not through
+/// `errno`; C11 wants `0`, `-1` for an interruption and another negative
+/// value for a failure.  There are no signals, so only the last two remain.
 #[unsafe(no_mangle)]
 pub unsafe extern "C" fn thrd_sleep(time1: &timespec, time2: *mut timespec) -> c_int {
-    ERRNO.set(0);
-    let ret = clock_nanosleep(CLOCK_REALTIME, 0, time1, time2);
-    let new_errno = ERRNO.get();
-    match ret {
+    match unsafe { clock_nanosleep(CLOCK_REALTIME, 0, time1, time2) } {
         0 => 0,
-        -1 if new_errno == EINTR => -1,
+        EINTR => -1,
         _ => -2,
     }
 }
diff --git a/src/header/time/mod.rs b/src/header/time/mod.rs
index 5d3afd3a..cf1e1a59 100755
--- a/src/header/time/mod.rs
+++ b/src/header/time/mod.rs
@@ -254,15 +254,56 @@ pub unsafe extern "C" fn clock_gettime(clock_id: clockid_t, tp: *mut timespec) -
 }
 
 /// See <https://pubs.opengroup.org/onlinepubs/9799919799/functions/clock_nanosleep.html>.
-// #[unsafe(no_mangle)]
-#[expect(unused_variables, reason = "function not yet implemented")]
-pub extern "C" fn clock_nanosleep(
+///
+/// POSIX reports failure as the return value rather than through `errno`.  An
+/// absolute deadline is turned into a relative interval against the same
+/// clock and then slept through the PAL, so the calling thread parks instead
+/// of spinning.  There are no signals, so `rmtp` is never written.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn clock_nanosleep(
     clock_id: clockid_t,
     flags: c_int,
     rqtp: *const timespec,
     rmtp: *mut timespec,
 ) -> c_int {
-    unimplemented!();
+    if rqtp.is_null() || flags & !TIMER_ABSTIME != 0 {
+        return EINVAL;
+    }
+    if clock_id != CLOCK_REALTIME && clock_id != CLOCK_MONOTONIC {
+        return EINVAL;
+    }
+    let request = unsafe { &*rqtp };
+    if request.tv_nsec < 0 || request.tv_nsec >= 1_000_000_000 {
+        return EINVAL;
+    }
+    if flags & TIMER_ABSTIME == 0 {
+        return match unsafe { Sys::nanosleep(rqtp, rmtp) } {
+            Ok(()) => 0,
+            Err(Errno(errno)) => errno,
+        };
+    }
+
+    let mut now = timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    if let Err(Errno(errno)) = Sys::clock_gettime(clock_id, Out::from_mut(&mut now)) {
+        return errno;
+    }
+    let seconds = request.tv_sec.saturating_sub(now.tv_sec);
+    let nanos = i64::from(request.tv_nsec) - i64::from(now.tv_nsec);
+    let total = seconds.saturating_mul(1_000_000_000).saturating_add(nanos);
+    if total <= 0 {
+        return 0;
+    }
+    let relative = timespec {
+        tv_sec: (total / 1_000_000_000) as time_t,
+        tv_nsec: (total % 1_000_000_000) as c_long,
+    };
+    match unsafe { Sys::nanosleep(&relative, rmtp) } {
+        Ok(()) => 0,
+        Err(Errno(errno)) => errno,
+    }
 }
 
 /// See <https://pubs.opengroup.org/onlinepubs/9799919799/functions/clock_getres.html>.
diff --git a/src/platform/irix7/mod.rs b/src/platform/irix7/mod.rs
index c33de197..d79f9596 100644
--- a/src/platform/irix7/mod.rs
+++ b/src/platform/irix7/mod.rs
@@ -13,7 +13,8 @@
 //! Known limits of the v0 ABI:
 //!
 //! * `poll` and blocking descriptor I/O are bounded by the cooperative kernel;
-//!   `nanosleep` is a busy wait.
+//!   `nanosleep` parks the thread and lets a cooperative peer run, and the
+//!   kernel drives the deadline from CP0 Count.
 //! * `futex_wait`/`futex_wake` map to the native futex gate.
 //! * `pthread_create` maps to `SYS_THREAD_CREATE`; the kernel is cooperative,
 //!   so a thread runs only when the creator yields, blocks or exits.  There is
@@ -99,6 +100,13 @@ const SYS_THREAD_EXIT: usize = 39;
 const SYS_FUTEX_WAIT: usize = 40;
 const SYS_FUTEX_WAKE: usize = 41;
 
+/// Longest a single `SYS_NANOSLEEP` parks.
+///
+/// The kernel bounds one park so the Count deadline stays below half the
+/// 32-bit timer range; `nanosleep` re-arms with the remainder.  This mirrors
+/// `SLEEP_LIMIT_MS` in `docs/spec/native-abi.md` §5.9.
+const SLEEP_LIMIT_MS: u64 = 60_000;
+
 // First instruction of a new thread.
 //
 // `rlct_clone` hands the kernel this address and the stack pointer that
@@ -832,8 +840,39 @@ impl Pal for Sys {
     }
 
     unsafe fn nanosleep(rqtp: *const timespec, _rmtp: *mut timespec) -> Result<()> {
-        // The kernel busy-waits and does not report the remaining time.
-        unsafe { syscall(SYS_NANOSLEEP, rqtp as usize, 0, 0, 0) }.map(|_| ())
+        // The kernel parks the calling thread until a CP0 Count deadline and
+        // lets a cooperative peer run.  One park is bounded so the deadline
+        // stays inside half the 32-bit timer range; an interval longer than
+        // that is re-armed with the remainder.  There are no signals, so the
+        // call is never interrupted and `rmtp` is not written.
+        if rqtp.is_null() {
+            return Err(Errno(EINVAL));
+        }
+        let request = unsafe { &*rqtp };
+        if request.tv_sec < 0 || request.tv_nsec < 0 || request.tv_nsec >= 1_000_000_000 {
+            return Err(Errno(EINVAL));
+        }
+        let mut remaining = (request.tv_sec as u64)
+            .saturating_mul(1_000_000_000)
+            .saturating_add(request.tv_nsec as u64);
+        while remaining > 0 {
+            let chunk = remaining.min(SLEEP_LIMIT_MS * 1_000_000);
+            let chunk_request = timespec {
+                tv_sec: (chunk / 1_000_000_000) as time_t,
+                tv_nsec: (chunk % 1_000_000_000) as c_long,
+            };
+            unsafe {
+                syscall(
+                    SYS_NANOSLEEP,
+                    &chunk_request as *const timespec as usize,
+                    0,
+                    0,
+                    0,
+                )
+            }?;
+            remaining -= chunk;
+        }
+        Ok(())
     }
 
     fn openat(dirfd: c_int, path: CStr, oflag: c_int, mode: mode_t) -> Result<c_int> {
