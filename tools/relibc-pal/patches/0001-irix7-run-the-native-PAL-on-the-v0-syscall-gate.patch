+/// Map a `CELL_E_*` status to the POSIX `errno` value.
+///
+/// This mirrors `crates/native-abi/src/status.rs::status_to_errno` in the
+/// kernel repository; the two tables are the shared error contract.
+const STATUS_ERRNO: [c_int; 53] = [
+    0,   // CELL_OK
+    1,   // EPERM
+    2,   // ENOENT
+    4,   // EINTR
+    5,   // EIO
+    9,   // EBADF
+    11,  // EAGAIN
+    12,  // ENOMEM
+    13,  // EACCES
+    14,  // EFAULT
+    16,  // EBUSY
+    17,  // EEXIST
+    22,  // EINVAL
+    28,  // ENOSPC
+    20,  // ENOTDIR
+    21,  // EISDIR
+    39,  // ENOTEMPTY
+    95,  // ENOTSUP
+    75,  // EOVERFLOW
+    110, // ETIMEDOUT
+    125, // ECANCELED
+    9,   // E_REVOKED -> EBADF
+    90,  // EMSGSIZE
+    71,  // EPROTO
+    111, // ECONNREFUSED
+    107, // ENOTCONN
+    98,  // EADDRINUSE
+    101, // ENETUNREACH
+    113, // EHOSTUNREACH
+    36,  // ENAMETOOLONG
+    40,  // ELOOP
+    10,  // ECHILD
+    3,   // ESRCH
+    38,  // ENOSYS
+    32,  // EPIPE
+    34,  // ERANGE
+    33,  // EDOM
+    35,  // EDEADLK
+    37,  // ENOLCK
+    42,  // ENOMSG
+    43,  // EIDRM
+    25,  // ENOTTY
+    29,  // ESPIPE
+    26,  // ETXTBSY
+    27,  // EFBIG
+    31,  // EMLINK
+    30,  // EROFS
+    19,  // ENODEV
+    6,   // ENXIO
+    15,  // ENOTBLK
+    7,   // E2BIG
+    24,  // EMFILE
+    23,  // ENFILE
+];
+
