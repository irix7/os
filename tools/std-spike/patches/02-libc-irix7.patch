+//! Definitions for the native IRIX 7 ABI (`target_os = "irix7"`).
+//!
+//! # SPIKE — compile-only scaffolding
+//!
+//! This module exists so that Rust `std` can be **compiled** for
+//! `targets/mips3-sgi-irix7-native-n32.json`.  It is not a working ABI
+//! binding and must not be presented as one:
+//!
+//! * Every function is an `extern "C"` declaration with no implementation.
+//!   Nothing here has been linked, run or checked against a real native libc.
+//! * The constants are **provisional**.  The native libc specification
+//!   (`docs/spec/native-libc.md`) intentionally leaves the numeric `errno`
+//!   values and most constant sets open; this file uses the Linux/asm-generic
+//!   values recommended by §4.3 of that document, plus clean, self-consistent
+//!   values for the file and socket flags.  They are placeholders for the M9
+//!   `native-abi` crate, not an ABI decision.
+//! * The public struct layouts follow §4.1 of the specification (n32,
+//!   big-endian, ILP32, 8-byte-aligned 64-bit fields).  A handful of types
+//!   that `std` never touches are omitted rather than guessed at; see the
+//!   "Deliberately absent" note at the end of the file.
+//! * `errno` values, signal numbers and `W*` encodings have never been
+//!   compared with a C implementation, because none exists yet.
+//!
+//! The intended path is that the M9 `native-abi` crate generates this module
+//! (research report §7.6: one source of truth).  Until then, this file is the
+//! evidence that the `std` Unix PAL for `irix7` can be type-checked.
+
+use crate::prelude::*;
+// Types that the shared `unix/mod.rs` defines once and re-exports through the
+// glob at the end of that module.  They must be imported here, not redefined.
+use crate::{
+    DIR, cc_t, gid_t, in6_addr, in_addr_t, in_port_t, iovec, pid_t, pollfd, sighandler_t, timespec,
+    uid_t,
+};
+
+/// MIPS/IRIX `wchar_t` is a signed 32-bit integer.
+pub type wchar_t = c_int;
+
+/// Opaque placeholder for `sem_t`; POSIX semaphores are optional and outside
+/// the v1 profile (spec §3.2, `[SEM]` = no).
+pub type sem_t = *mut c_void;
+
