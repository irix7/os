+#[cfg(target_os = "irix7")]
+pub fn current_exe() -> io::Result<PathBuf> {
+    // The native cell loader supplies the image path through `getexecname`
+    // (a documented extension; spec §3.4).  `/proc/self/exe` is not a native
+    // requirement.
+    let ptr = unsafe { libc::getexecname() };
+    if ptr.is_null() {
+        Err(io::const_error!(
+            io::ErrorKind::Unsupported,
+            "the cell loader did not provide an executable path"
+        ))
+    } else {
+        let bytes = unsafe { CStr::from_ptr(ptr) }.to_bytes().to_vec();
+        Ok(PathBuf::from(OsString::from_vec(bytes)))
+    }
+}
