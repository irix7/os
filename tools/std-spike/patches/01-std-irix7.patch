+//! IRIX 7-specific extensions to primitives in the [`std`] crate.
+//!
+//! # SPIKE
+//!
+//! This module exists so that `std` can be compiled for
+//! `target_os = "irix7"` (the native IRIX 7 target).  It is deliberately
+//! small: it satisfies the two `platform` imports that `std::os::unix` makes
+//! (`fs::MetadataExt` and `raw` type aliases) and nothing else.  A native
+//! loader, a libc and a cell runtime do not exist yet, so none of this has
+//! been exercised.
+//!
+//! The real `os::irix7` surface should grow from
+//! `docs/spec/native-libc.md`, not from copying another platform's module.
+
+#[stable(feature = "rust1", since = "1.0.0")]
+pub mod fs;
+#[stable(feature = "rust1", since = "1.0.0")]
+pub mod raw;
