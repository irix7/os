+//! Compile-time layout cross-check against `native-abi`.
+//!
+//! `native-abi` is the source of truth for the native n32 layouts.  This
+//! module is compiled as part of `libc` for the `irix7` target (32-bit
+//! pointers), and every assertion compares the spike's public type with the
+//! committed `native-abi` type: size, alignment and the documented field
+//! offsets.  A failure means the spike has drifted from the ABI crate.
+//!
+//! The types are still **provisional**.  Passing this check is not a C
+//! verification and does not freeze the ABI.  `FILE` and `DIR` are opaque
+//! extern types in `libc`, as the specification requires, so their storage is
+//! not asserted; `native-abi`'s 128-byte placeholders are host-testable
+//! stand-ins, not an ABI claim.
+#![allow(clippy::assertions_on_constants)]
+
+use super::*;
+use crate::{
+    in6_addr,
+    iovec,
+    pollfd,
+    rlimit,
+    timespec,
+    timeval,
+    winsize,
+    DIR,
+    FILE,
+};
+
+/// Assert that a `libc` type and a `native-abi` type have the same size and
+/// alignment.
+macro_rules! same_layout {
+    ($libc:ty, $abi:ty) => {
+        const _: () = {
+            assert!(core::mem::size_of::<$libc>() == core::mem::size_of::<$abi>());
+            assert!(core::mem::align_of::<$libc>() == core::mem::align_of::<$abi>());
+        };
+    };
+}
+
+/// Assert that each named field has the same offset in both types.
+macro_rules! same_fields {
+    ($libc:ty, $abi:ty, $($field:ident),+ $(,)?) => {
+        $(
+            const _: () = assert!(
+                core::mem::offset_of!($libc, $field) == core::mem::offset_of!($abi, $field)
+            );
+        )+
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Fundamental types (spec §4.1)
+// ---------------------------------------------------------------------------
+
+same_layout!(c_char, native_abi::c_char);
+same_layout!(c_int, native_abi::c_int);
+same_layout!(c_long, native_abi::c_long);
+same_layout!(size_t, native_abi::size_t);
+same_layout!(ssize_t, native_abi::ssize_t);
+same_layout!(off_t, native_abi::off_t);
+same_layout!(ino_t, native_abi::ino_t);
+same_layout!(dev_t, native_abi::dev_t);
+same_layout!(mode_t, native_abi::mode_t);
+same_layout!(nlink_t, native_abi::nlink_t);
+same_layout!(blkcnt_t, native_abi::blkcnt_t);
+same_layout!(blksize_t, native_abi::blksize_t);
+same_layout!(pid_t, native_abi::pid_t);
+same_layout!(uid_t, native_abi::uid_t);
+same_layout!(gid_t, native_abi::gid_t);
+same_layout!(id_t, native_abi::id_t);
+same_layout!(time_t, native_abi::time_t);
+same_layout!(clockid_t, native_abi::clockid_t);
+same_layout!(socklen_t, native_abi::socklen_t);
+same_layout!(sa_family_t, native_abi::sa_family_t);
+same_layout!(rlim_t, native_abi::rlim_t);
+same_layout!(wchar_t, native_abi::wchar_t);
+same_layout!(pthread_t, native_abi::pthread_t);
+same_layout!(pthread_key_t, native_abi::pthread_key_t);
+
+// ---------------------------------------------------------------------------
+// Structs: size and alignment
+// ---------------------------------------------------------------------------
+
+same_layout!(timespec, native_abi::timespec);
+same_layout!(timeval, native_abi::timeval);
+same_layout!(iovec, native_abi::iovec);
+same_layout!(pollfd, native_abi::pollfd);
+same_layout!(winsize, native_abi::winsize);
+same_layout!(rlimit, native_abi::rlimit);
+same_layout!(stat, native_abi::stat);
+same_layout!(dirent, native_abi::dirent);
+same_layout!(posix_dent, native_abi::posix_dent);
+same_layout!(sigset_t, native_abi::sigset_t);
+same_layout!(stack_t, native_abi::stack_t);
+same_layout!(in_addr, native_abi::in_addr);
+same_layout!(in6_addr, native_abi::in6_addr);
+same_layout!(sockaddr, native_abi::sockaddr);
+same_layout!(sockaddr_in, native_abi::sockaddr_in);
+same_layout!(sockaddr_in6, native_abi::sockaddr_in6);
+same_layout!(sockaddr_storage, native_abi::sockaddr_storage);
+same_layout!(sockaddr_un, native_abi::sockaddr_un);
+same_layout!(msghdr, native_abi::msghdr);
+same_layout!(cmsghdr, native_abi::cmsghdr);
+same_layout!(addrinfo, native_abi::addrinfo);
+same_layout!(linger, native_abi::linger);
+same_layout!(fd_set, native_abi::fd_set);
+same_layout!(termios, native_abi::termios);
+same_layout!(passwd, native_abi::passwd);
+same_layout!(utsname, native_abi::utsname);
+same_layout!(Dl_info, native_abi::Dl_info);
+same_layout!(pthread_attr_t, native_abi::pthread_attr_t);
+same_layout!(pthread_mutex_t, native_abi::pthread_mutex_t);
+same_layout!(pthread_mutexattr_t, native_abi::pthread_mutexattr_t);
+same_layout!(pthread_cond_t, native_abi::pthread_cond_t);
+same_layout!(pthread_condattr_t, native_abi::pthread_condattr_t);
+same_layout!(pthread_rwlock_t, native_abi::pthread_rwlock_t);
+same_layout!(pthread_rwlockattr_t, native_abi::pthread_rwlockattr_t);
+same_layout!(sem_t, native_abi::sem_t);
+
+// ---------------------------------------------------------------------------
+// Structs: documented field offsets
+// ---------------------------------------------------------------------------
+
+same_fields!(timespec, native_abi::timespec, tv_sec, tv_nsec);
+same_fields!(timeval, native_abi::timeval, tv_sec, tv_usec);
+same_fields!(iovec, native_abi::iovec, iov_base, iov_len);
+same_fields!(pollfd, native_abi::pollfd, fd, events, revents);
+same_fields!(
+    winsize,
+    native_abi::winsize,
+    ws_row,
+    ws_col,
+    ws_xpixel,
+    ws_ypixel
+);
+same_fields!(rlimit, native_abi::rlimit, rlim_cur, rlim_max);
+same_fields!(
+    stat,
+    native_abi::stat,
+    st_dev,
+    st_ino,
+    st_mode,
+    st_nlink,
+    st_uid,
+    st_gid,
+    st_rdev,
+    st_size,
+    st_blksize,
+    st_blocks,
+    st_atim,
+    st_mtim,
+    st_ctim
+);
+const _: () = assert!(
+    core::mem::offset_of!(stat, __st_spare) == core::mem::offset_of!(native_abi::stat, _reserved)
+);
+same_fields!(
+    dirent,
+    native_abi::dirent,
+    d_ino,
+    d_off,
+    d_reclen,
+    d_type,
+    d_name
+);
+same_fields!(
+    posix_dent,
+    native_abi::posix_dent,
+    d_ino,
+    d_off,
+    d_reclen,
+    d_type,
+    d_name
+);
+const _: () = assert!(
+    core::mem::offset_of!(sigset_t, __val) == core::mem::offset_of!(native_abi::sigset_t, bits)
+);
+same_fields!(stack_t, native_abi::stack_t, ss_sp, ss_size, ss_flags);
+same_fields!(in_addr, native_abi::in_addr, s_addr);
+same_fields!(in6_addr, native_abi::in6_addr, s6_addr);
+same_fields!(sockaddr, native_abi::sockaddr, sa_family, sa_data);
+same_fields!(
+    sockaddr_in,
+    native_abi::sockaddr_in,
+    sin_family,
+    sin_port,
+    sin_addr,
+    sin_zero
+);
+same_fields!(
+    sockaddr_in6,
+    native_abi::sockaddr_in6,
+    sin6_family,
+    sin6_port,
+    sin6_flowinfo,
+    sin6_addr,
+    sin6_scope_id
+);
+// The padding members have different names; only the public family field is
+// comparable.
+same_fields!(sockaddr_storage, native_abi::sockaddr_storage, ss_family);
+same_fields!(sockaddr_un, native_abi::sockaddr_un, sun_family, sun_path);
+same_fields!(
+    msghdr,
+    native_abi::msghdr,
+    msg_name,
+    msg_namelen,
+    msg_iov,
+    msg_iovlen,
+    msg_control,
+    msg_controllen,
+    msg_flags
+);
+same_fields!(
+    cmsghdr,
+    native_abi::cmsghdr,
+    cmsg_len,
+    cmsg_level,
+    cmsg_type
+);
+same_fields!(
+    addrinfo,
+    native_abi::addrinfo,
+    ai_flags,
+    ai_family,
+    ai_socktype,
+    ai_protocol,
+    ai_addrlen,
+    ai_addr,
+    ai_canonname,
+    ai_next
+);
+same_fields!(linger, native_abi::linger, l_onoff, l_linger);
+const _: () = assert!(
+    core::mem::offset_of!(fd_set, fds_bits) == core::mem::offset_of!(native_abi::fd_set, bits)
+);
+same_fields!(
+    termios,
+    native_abi::termios,
+    c_iflag,
+    c_oflag,
+    c_cflag,
+    c_lflag,
+    c_line,
+    c_cc,
+    c_ispeed,
+    c_ospeed
+);
+same_fields!(
+    passwd,
+    native_abi::passwd,
+    pw_name,
+    pw_passwd,
+    pw_uid,
+    pw_gid,
+    pw_gecos,
+    pw_dir,
+    pw_shell
+);
+same_fields!(
+    utsname,
+    native_abi::utsname,
+    sysname,
+    nodename,
+    release,
+    version,
+    machine
+);
+same_fields!(
+    Dl_info,
+    native_abi::Dl_info,
+    dli_fname,
+    dli_fbase,
+    dli_sname,
+    dli_saddr
+);
+const _: () = assert!(
+    core::mem::offset_of!(sem_t, __opaque) == core::mem::offset_of!(native_abi::sem_t, _opaque)
+);
+
+// `FILE` and `DIR` are opaque extern types in both the specification and
+// `libc`; there is no storage layout to compare, only the width of the
+// pointers used to reach them.
+const _: () = {
+    assert!(core::mem::size_of::<*mut FILE>() == core::mem::size_of::<usize>());
+    assert!(core::mem::size_of::<*mut DIR>() == core::mem::size_of::<usize>());
+};
